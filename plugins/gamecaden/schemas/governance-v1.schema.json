{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:game-workflow:governance:v1",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "outcomes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "outcome",
              "milestone"
            ]
          },
          "scope": {
            "type": "string",
            "minLength": 1
          },
          "work": {
            "type": "array",
            "items": {
              "$ref": "urn:game-workflow:format:v1#/$defs/Ref"
            }
          }
        },
        "required": [
          "id",
          "title",
          "work"
        ],
        "additionalProperties": false
      }
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "domain": {
            "type": "string",
            "minLength": 1
          },
          "scope": {
            "type": "string",
            "minLength": 1
          },
          "authority": {
            "enum": [
              "effective",
              "proposed",
              "reference",
              "historical",
              "unknown"
            ]
          },
          "applies_to": {
            "type": "array",
            "items": {
              "$ref": "urn:game-workflow:format:v1#/$defs/Ref"
            }
          },
          "layer": {
            "enum": [
              "common",
              "domain",
              "engine",
              "project"
            ]
          }
        },
        "required": [
          "id",
          "title",
          "domain",
          "scope",
          "authority"
        ],
        "additionalProperties": false
      }
    },
    "materials": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "domain": {
            "type": "string",
            "minLength": 1
          },
          "requirement": {
            "enum": [
              "required",
              "conditional",
              "optional"
            ]
          },
          "applicability": {
            "enum": [
              "applies",
              "unknown",
              "not_applicable"
            ]
          },
          "for_actions": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "purpose": {
            "type": "string",
            "minLength": 1
          },
          "ref": {
            "$ref": "urn:game-workflow:format:v1#/$defs/Ref"
          },
          "applicability_reason": {
            "type": "string",
            "minLength": 1
          },
          "applies_to": {
            "type": "array",
            "items": {
              "$ref": "urn:game-workflow:format:v1#/$defs/Ref"
            }
          }
        },
        "required": [
          "id",
          "title",
          "domain",
          "requirement",
          "applicability",
          "for_actions",
          "purpose"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "applicability": {
                  "const": "not_applicable"
                }
              },
              "required": [
                "applicability"
              ]
            },
            "then": {
              "required": [
                "applicability_reason"
              ]
            }
          }
        ]
      }
    },
    "conditions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "domain": {
            "type": "string",
            "minLength": 1
          },
          "scope": {
            "type": "string",
            "minLength": 1
          },
          "action": {
            "type": "string",
            "minLength": 1
          },
          "strength": {
            "enum": [
              "required",
              "advisory"
            ]
          },
          "authority": {
            "enum": [
              "effective",
              "proposed",
              "reference",
              "historical",
              "unknown"
            ]
          },
          "applicability": {
            "enum": [
              "applies",
              "unknown",
              "not_applicable"
            ]
          },
          "applies_to": {
            "type": "array",
            "items": {
              "$ref": "urn:game-workflow:format:v1#/$defs/Ref"
            },
            "minItems": 1
          },
          "check": {
            "type": "object",
            "properties": {
              "kind": {
                "enum": [
                  "evidence",
                  "decision"
                ]
              },
              "subject": {
                "allOf": [
                  {
                    "$ref": "urn:game-workflow:format:v1#/$defs/Subject"
                  },
                  {
                    "type": "object",
                    "required": [
                      "version"
                    ]
                  }
                ]
              },
              "proofs": {
                "type": "array",
                "items": {
                  "$ref": "urn:game-workflow:format:v1#/$defs/Ref"
                }
              },
              "coverage": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "actor_kind": {
                "enum": [
                  "user",
                  "agent",
                  "tool"
                ]
              },
              "event_scope": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "kind",
              "subject"
            ],
            "additionalProperties": false
          },
          "applicability_reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "title",
          "domain",
          "scope",
          "action",
          "strength",
          "authority",
          "applies_to"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "applicability": {
                  "const": "not_applicable"
                }
              },
              "required": [
                "applicability"
              ]
            },
            "then": {
              "required": [
                "applicability_reason"
              ]
            }
          }
        ]
      }
    },
    "flows": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "scope": {
            "type": "string",
            "minLength": 1
          },
          "authority": {
            "enum": [
              "effective",
              "proposed",
              "reference",
              "historical",
              "unknown"
            ]
          },
          "steps": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "title": {
                  "type": "string",
                  "minLength": 1
                },
                "group": {
                  "type": "string"
                },
                "target": {
                  "$ref": "urn:game-workflow:format:v1#/$defs/Ref"
                },
                "action": {
                  "type": "string",
                  "minLength": 1
                },
                "requires": {
                  "$ref": "#/$defs/Requires"
                }
              },
              "required": [
                "id",
                "title",
                "target",
                "action"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "id",
          "title",
          "scope",
          "authority",
          "steps"
        ],
        "additionalProperties": false
      }
    },
    "relationships": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "from": {
            "$ref": "urn:game-workflow:format:v1#/$defs/Ref"
          },
          "to": {
            "$ref": "urn:game-workflow:format:v1#/$defs/Ref"
          },
          "kind": {
            "enum": [
              "delegates_to",
              "produces",
              "consumes",
              "defines",
              "provides_policy"
            ]
          },
          "authority": {
            "enum": [
              "effective",
              "proposed",
              "reference",
              "historical",
              "unknown"
            ]
          },
          "label": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "from",
          "to",
          "kind",
          "authority"
        ],
        "additionalProperties": false
      }
    },
    "navigation": {
      "type": "object",
      "properties": {
        "domain": {
          "type": "string"
        },
        "responsibility": {
          "type": "string"
        },
        "parent": {
          "$ref": "urn:game-workflow:format:v1#/$defs/Ref"
        }
      },
      "minProperties": 1,
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version"
  ],
  "additionalProperties": false,
  "$defs": {
    "Requires": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "condition": {
              "$ref": "urn:game-workflow:format:v1#/$defs/Ref"
            }
          },
          "required": [
            "condition"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "step": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "step"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "all": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/Requires"
              }
            }
          },
          "required": [
            "all"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "any": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/Requires"
              }
            }
          },
          "required": [
            "any"
          ],
          "additionalProperties": false
        }
      ]
    }
  }
}
